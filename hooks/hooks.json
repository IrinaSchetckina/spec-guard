{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/test-gate.sh",
            "args": [],
            "timeout": 180,
            "statusMessage": "Running the gate for the edited area…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/test-gate-stop.sh",
            "args": [],
            "timeout": 300,
            "statusMessage": "Final gate: project tests…"
          }
        ]
      }
    ]
  }
}
